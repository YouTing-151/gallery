<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.gallery.gallerybackend.mapper.UserMapper">

    <resultMap id="userResultMap" type="com.gallery.gallerybackend.entity.User">
        <id column="id" property="id"/>
        <result column="account" property="account"/>
        <result column="password" property="password"/>
        <result column="nickname" property="nickname"/>
        <result column="user_code" property="userCode"/>
        <result column="role" property="role"/>
        <result column="avatar" property="avatar"/>
        <result column="status" property="status"/>
        <result column="create_time" property="createTime"/>
        <result column="update_time" property="updateTime"/>
    </resultMap>

    <sql id="userColumns">
        id, account, password, nickname, user_code, role, avatar, status, create_time, update_time
    </sql>

    <select id="selectByAccount" resultMap="userResultMap">
        SELECT <include refid="userColumns"/>
        FROM `user`
        WHERE account = #{account}
    </select>

    <select id="selectById" resultMap="userResultMap">
        SELECT <include refid="userColumns"/>
        FROM `user`
        WHERE id = #{id}
    </select>

    <select id="selectByRole" resultMap="userResultMap">
        SELECT <include refid="userColumns"/>
        FROM `user`
        WHERE role = #{role}
        LIMIT 1
    </select>

</mapper>
